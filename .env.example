# LLM（OpenAI 兼容；AI 对话默认走此处，DeepSeek 示例见下）
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o-mini

# Embedding
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_API_KEY=sk-xxx
EMBED_MODEL=text-embedding-3-small

# 视频配音：dashscope（百炼 sk-ws-）| edge | openai
TTS_PROVIDER=dashscope
DASHSCOPE_API_KEY=sk-ws-your-key
DASHSCOPE_TTS_MODEL=cosyvoice-v3-flash
DASHSCOPE_TTS_VOICE=longanyang

# 视频合成（可选）：FFmpeg 的 bin 目录；留空则自动找系统 PATH 或 项目 tools/ffmpeg/bin
# FFMPEG_BIN_DIR=C:/Users/admin/Desktop/个人2/tools/ffmpeg/bin

# 数据目录
DATA_DIR=./data
CHROMA_DIR=./chroma

# MySQL（小皮/phpStudy 本地库 ai）
DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/ai?charset=utf8mb4

# 知识库 seed 文档（桌面理论题目录）
SEED_DOCS_DIR=C:/Users/admin/Desktop/理论题
SEED_DOC_FILES=复盘(1).md,面试题整理_含回答思路.md,AI相关面试题整理.md

# 前后端分离：Vue 开发服务器
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# 多用户会话（务必修改生产密钥）
SESSION_SECRET=dev-session-secret-change-me
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123

# RAG
RAG_TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=100
# 知识库问答是否调用大模型归纳（false=仅 MySQL/Chroma 检索+摘录）
RAG_KB_USE_LLM=false

# Agent
MAX_AGENT_STEPS=8
AGENT_TIMEOUT_SECONDS=600

# 趣味视频测试（true=渐变/emoji/轻动效；说「测试结束」改为 false）
VIDEO_FUN_TEST=true

# 趣味视频测试（true=渐变/emoji/轻动效；测试结束改 false 恢复白底文字幻灯片）
VIDEO_FUN_TEST=true
